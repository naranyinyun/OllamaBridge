# 选择当前启用的上游服务商（默认 deepseek），支持任意 OpenAI 兼容前缀（如 deepseek / openai / qwen / moonshot）
PROVIDER=deepseek

# 方式一：按 PROVIDER 前缀分别配置多个服务商，通过修改 PROVIDER 一键切换
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# QWEN_API_KEY=your_qwen_api_key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# 方式二：通用上游配置（优先级高于按 PROVIDER 前缀的配置）
# UPSTREAM_API_KEY=your_api_key
# UPSTREAM_BASE_URL=https://api.example.com/v1
# UPSTREAM_MODEL=your-model-name
